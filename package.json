{
  "name": "server-manager",
  "productName": "Server Manager",
  "version": "1.0.0",
  "description": "Start, watch and clean your Garry's Mod dev server",
  "author": "sogekiDEV",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sogekiDEV/Gmod-Server-Manager.git"
  },
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-packager . \"Server Manager\" --platform=win32 --arch=x64 --out=release --icon=build/icon.ico --overwrite --prune=true --ignore=\"^/(src|tests|release|\\.vscode|screenshots)\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-vite": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
